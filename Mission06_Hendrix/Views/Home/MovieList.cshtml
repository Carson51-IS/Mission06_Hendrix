@*
    Movie List view (Mission 7): Displays all movies in the Joel Hilton Movie Collection.
    - Model is a list of Movie objects passed from HomeController.MovieList().
    - Bootstrap table classes (table-striped, table-bordered, table-hover) give a professional look.
    - Edit and Delete use Tag Helpers (asp-action, asp-route-id) so URLs stay correct if routes change.
*@
@model IEnumerable<Mission06_Hendrix.Models.Movie>
@{
    ViewData["Title"] = "Movie List";
}

<div class="mb-4">
    <h2>Joel Hilton Movie Collection</h2>
    <p class="text-muted">All movies in the collection. Use Edit to update or Delete to remove.</p>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Year</th>
                <th>Director</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Copied to Plex</th>
                <th>Lent To</th>
                <th>Notes</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@(movie.Title ?? "—")</td>
                    <td>@(movie.Category?.CategoryName ?? "—")</td>
                    <td>@(movie.Year?.ToString() ?? "—")</td>
                    <td>@(movie.Director ?? "—")</td>
                    <td>@(movie.Rating ?? "—")</td>
                    @* Display Yes/No for nullable bools; "—" if null (legacy data). *@
                    <td>@(movie.Edited == true ? "Yes" : movie.Edited == false ? "No" : "—")</td>
                    <td>@(movie.CopiedToPlex == true ? "Yes" : movie.CopiedToPlex == false ? "No" : "—")</td>
                    <td>@(movie.LentTo ?? "—")</td>
                    <td>@(movie.Notes ?? "—")</td>
                    @* Tag Helpers generate correct links; asp-route-id passes the movie's primary key. *@
                    <td><a asp-action="EditMovie" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary">Edit</a></td>
                    <td><a asp-action="DeleteMovie" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-danger">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
