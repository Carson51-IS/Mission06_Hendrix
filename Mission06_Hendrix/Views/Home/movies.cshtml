@*
    Add Movie view (Mission 6/7): Form to add a new movie to the Joel Hilton Movie Collection.
    Model binding: when the form posts, ASP.NET maps input values to Movie properties.
    Mission 7: Title, Year, Edited, and Copied to Plex are required; Year must be 1888 or later.
*@
@model Mission06_Hendrix.Models.Movie
@{
    ViewData["Title"] = "Add Movie";
}

<div class="container">
    <h1>Add Movie to Collection</h1>

    @* 
        TAG HELPERS: asp-action/asp-controller generate the correct action URL.
        method="post" sends form data to the server (GET would put it in the URL).
    *@
    <form asp-action="Movies" asp-controller="Home" method="post" class="mt-4">
        @* Shows all validation errors from the Model (from [Required], [StringLength], etc.) *@
        <div asp-validation-summary="All" class="text-danger"></div>

        @* Category: optional; must be a valid CategoryId from the database (Joel Hilton DB FK). *@
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">-- Optional --</option>
                @foreach (var c in (ViewBag.Categories as IEnumerable<Mission06_Hendrix.Models.Category>) ?? Enumerable.Empty<Mission06_Hendrix.Models.Category>())
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
            <small class="form-text text-muted">Optional</small>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" placeholder="Movie title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        @* Required: Year, 1888 or later (Mission 7). *@
        <div class="mb-3">
            <label asp-for="Year" class="form-label">Year</label>
            <input asp-for="Year" class="form-control" type="number" min="1888" max="2100" placeholder="e.g., 2024" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Director" class="form-label">Director</label>
            <input asp-for="Director" class="form-control" placeholder="Director name" />
            <small class="form-text text-muted">Optional</small>
        </div>

        @* Rating: optional dropdown (G, PG, PG-13, R). *@
        <div class="mb-3">
            <label asp-for="Rating" class="form-label">Rating</label>
            <select asp-for="Rating" class="form-select">
                <option value="">-- Select Rating --</option>
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
            <small class="form-text text-muted">Optional</small>
        </div>

        @* Edited: required (Mission 7). User must select Yes or No. *@
        <div class="mb-3">
            <label asp-for="Edited" class="form-label">Edited</label>
            <select asp-for="Edited" class="form-select">
                <option value="">-- Select --</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
            <span asp-validation-for="Edited" class="text-danger"></span>
        </div>

        @* Copied to Plex: required (Mission 7). *@
        <div class="mb-3">
            <label asp-for="CopiedToPlex" class="form-label">Copied to Plex</label>
            <select asp-for="CopiedToPlex" class="form-select">
                <option value="">-- Select --</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
            <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LentTo" class="form-label">Lent To</label>
            <input asp-for="LentTo" class="form-control" placeholder="Person you lent the movie to" />
            <small class="form-text text-muted">Optional</small>
        </div>

        @* maxlength="25" limits input on client; [StringLength(25)] validates on server (defense in depth) *@
        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes</label>
            <input asp-for="Notes" class="form-control" maxlength="25" placeholder="Max 25 characters" />
            <span asp-validation-for="Notes" class="text-danger"></span>
            <small class="form-text text-muted">Optional, limited to 25 characters</small>
        </div>

        <button type="submit" class="btn btn-primary">Add Movie</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@* 
    SECTION: Renders this block in _Layout's @RenderSectionAsync("Scripts").
    _ValidationScriptsPartial includes jQuery validation for client-side checks (faster feedback than server round-trip).
*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
